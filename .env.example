# ============================================================
# VARIABLES DE ENTORNO — AZURE APP SERVICE (LINUX)
# ============================================================

# Puerto asignado por Azure App Service (por defecto 8080)
PORT=8080

# API Keys aisladas de Google AI Studio (@google/genai)
GEMINI_API_KEY_A=AIzaSy_TU_CLAVE_PARA_PORTFOLIO_A_SACIJIM
GEMINI_API_KEY_B=AIzaSy_TU_CLAVE_PARA_PORTFOLIO_B_ALEXITO_HUB

# Modelo Gemini configurado para Structured Outputs
GEMINI_MODEL=gemini-3.5-flash-lite

# Ruta persistente montada en Azure App Service (/home persiste entre reinicios)
STORAGE_PATH=/home/site/data/chat-sessions.json

# Orígenes permitidos por la política CORS (separados por comas, sin espacios)
ALLOWED_ORIGINS=https://ai.aurx.pro,https://aurx.pro,https://sacijim.github.io,https://alexito-hub.github.io,http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# Límite de turnos enviados como ventana de contexto al LLM
MAX_CONTEXT_TURNS=12
